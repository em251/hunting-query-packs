// ============================================================================
// PACK: Cloud  |  QUERY: C02 - Cloud app activity timeline (raw rows for one account)
// Tables: CloudAppEvents
// Inputs: InputAccountId, InputApplication, InputObjectName (all OPTIONAL)
// Perf:   time-bounded with 'between'; entity filters before summarize/joins.
// Schema: verified against the current Defender XDR advanced hunting schema.
//         CloudAppEvents has NO AccountUpn column - the actor is AccountId
//         (usually the UPN) plus AccountObjectId. CloudAuditEvents has no actor
//         column at all: the principal lives inside RawEventData.
// ============================================================================
// Read top-down when reconstructing what an attacker did with a stolen session.
// RawEventData carries the operation parameters (mailbox rule contents, sharing
// links, permission grants), which is usually where the evidence is.

let LookbackStart = ago(7d);
let LookbackEnd   = now();
let InputAccountId    = "";
let InputApplication  = "";
let InputObjectName   = "";

CloudAppEvents
| where Timestamp between (LookbackStart .. LookbackEnd)
| where (isempty(InputAccountId)   or AccountId =~ InputAccountId
                                   or AccountDisplayName has InputAccountId)
    and (isempty(InputApplication) or Application =~ InputApplication)
    and (isempty(InputObjectName)  or ObjectName has InputObjectName)
| project Timestamp, Application, ActionType, ActivityType, AccountId, IPAddress,
          CountryCode, City, Isp, UserAgent, IsAdminOperation, IsAnonymousProxy,
          ObjectType, ObjectName, ObjectId, SessionData, RawEventData
| order by Timestamp asc
| take 1000
